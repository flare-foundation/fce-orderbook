# Xaman developer credentials — create an app at https://apps.xaman.dev
# Keep the secret SERVER-SIDE ONLY. Never ship it to the browser.
XAMAN_API_KEY=
XAMAN_API_SECRET=

# Port this service listens on.
PORT=8787

# Allowed browser origin (your frontend dev URL). Use * only for local dev.
CORS_ORIGIN=http://localhost:5173

# Relayer: a funded C2FLR key that pays gas for the fast path (mint / depositFor /
# executeWithdrawal on behalf of gasless XRPL-keyed accounts). Leave unset to
# disable the /relay endpoints.
RELAYER_PRIVATE_KEY=
CHAIN_RPC=https://coston2-api.flare.network/ext/C/rpc
